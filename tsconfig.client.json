{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": false,
    "esModuleInterop": true
  },
  "include": ["src/client/**/*.ts", "src/client/**/*.tsx", "src/design/**/*.ts", "src/design/**/*.tsx", "src/view/spec.ts"]
}
